# events-fsa — external connection config for team members
# ─────────────────────────────────────────────────────────
# Generated from .env.team.template. Fill placeholders from the server .env.
# Never commit to version control.

# ── App ────────────────────────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=FILL_FROM_SERVER_ENV

# ── Kafka (plaintext) ──────────────────────────────────────────────────────────
KAFKA_BROKER=kafka.maik.io.vn:9092

# ── Postgres (plaintext) ───────────────────────────────────────────────────────
AUTH_DATABASE_URL=postgresql://auth_app:FILL_FROM_SERVER_ENV@db-notif.maik.io.vn:5432/auth_db?schema=public
EVENTS_DATABASE_URL=postgresql://events_app:FILL_FROM_SERVER_ENV@db-notif.maik.io.vn:5432/events_db?schema=public
NOTIFICATIONS_DATABASE_URL=postgresql://notifications_app:FILL_FROM_SERVER_ENV@db-notif.maik.io.vn:5432/notifications_db?schema=public

# ── Redis (plaintext, no auth) ─────────────────────────────────────────────────
REDIS_HOST=cache.maik.io.vn
REDIS_PORT=6379

# ── Firebase Cloud Messaging ───────────────────────────────────────────────────
# Get from Firebase Console → Project settings → Service accounts → Generate key.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
