# --- API Gateway ---
PORT=3000

# --- Kafka ---
# The host:port the app uses to bootstrap. Plaintext listener on the docker
# network. Override per environment if needed.
KAFKA_BROKER=kafka:29092

# --- gRPC (gateway -> auth/events) ---
# Server-side bind ports (auth/events main.ts) and client-side connection
# URLs (api-gateway). In docker-compose these resolve via service-name DNS.
AUTH_GRPC_PORT=50051
AUTH_GRPC_URL=auth:50051
EVENTS_GRPC_PORT=50052
EVENTS_GRPC_URL=events:50052

# --- Redis ---
# In-cluster: connect directly to the redis container on the docker network.
# Plaintext, no auth.
REDIS_HOST=redis
REDIS_PORT=6379

# --- Postgres (one instance, three DBs) ---
AUTH_DATABASE_URL=postgresql://auth_app:__SET_ME__@postgres:5432/auth_db?schema=public
EVENTS_DATABASE_URL=postgresql://events_app:__SET_ME__@postgres:5432/events_db?schema=public
NOTIFICATIONS_DATABASE_URL=postgresql://notifications_app:__SET_ME__@postgres:5432/notifications_db?schema=public

# --- Firebase Cloud Messaging ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# --- Auth ---
JWT_SECRET=change-me-in-production

# --- Admin roles ---
# Initial admin accounts are granted via `npm run seed:admin-roles` (see scripts/seed-admin-roles.ts), not this file.
