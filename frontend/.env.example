# API target is selected per-mode, not here. Copy this file to `.env` (Firebase
# vars only), then create the two target files:
#   .env.development  ->  VITE_API_BASE_URL=http://localhost:3000/api/v1        (npm run dev)
#   .env.prod         ->  VITE_API_BASE_URL=http://157.180.69.127:3000/api/v1  (npm run dev:prod)
# Deployed builds get VITE_API_BASE_URL from the Dockerfile/CI instead.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
